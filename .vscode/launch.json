{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Live Server (live_server.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/live_server.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
