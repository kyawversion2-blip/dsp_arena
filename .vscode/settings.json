{
  "python.defaultInterpreterPath": "${workspaceFolder}/.uv-venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "."
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/*.bak*": true
  }
}
